module^eosRestart

import^eos

let^config = {
    productId="11111111111111111111111111111111",
    sandboxId="22222222222222222222222222222222",
    deploymentId="33333333333333333333333333333333",
    clientId="44444444444444444444444444444444",
    clientSecret="55555555555555555555555555555555",
    cacheDirectory="cache",
    socketName="test"
}

# Keep a client alive until the host destroys this VM and Program.
let^client = eos.create(config) catch^panic^it^
public^let^run = p^{
    client.tick() catch^panic^it^
    return^0
}
