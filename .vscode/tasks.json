{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Update dependency revisions",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/update-revisions.ps1", "-Dependency", "${input:dependency}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "dependency",
            "type": "pickString",
            "description": "更新する依存先（リモート main の最新コミット）",
            "options": ["all", "lhat", "eos-sdk"],
            "default": "all"
        }
    ]
}
